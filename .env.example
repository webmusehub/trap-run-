# TRAP RUN — PUBLIC RELEASE ENVIRONMENT CONFIGURATION
# Copy this file to .env or set environment variables in your deployment portal (Vercel/Cloudflare Pages).

# Supabase Public Anonymous Credentials (SAFE FOR FRONTEND)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Optional Analytics & Ad Provider Configurations
VITE_ANALYTICS_ENDPOINT=https://analytics.webmusehub.com/api/v1/event

# IMPORTANT SECURITY REMINDER:
# NEVER place SUPABASE_SERVICE_ROLE_KEY or Database Passwords inside frontend environment variables or Git repos!
